TRADING212_API_KEY=<your API key ID>
TRADING212_API_SECRET=<your API secret>
TRADING212_ENVIRONMENT=demo
# Primary provider: LiteLLM proxy (the proxy holds GITHUB_API_KEY)
LITE_LLM_BASE_URL=http://localhost:4000
LITE_LLM_MODEL=gpt-5.6-luna
LITE_LLM_API_KEY=<your LiteLLM proxy key>
LITE_LLM_TIMEOUT=30
# Optional fallback provider
GEMINI_API_KEY=<your Gemini API key from https://aistudio.google.com/apikey>
